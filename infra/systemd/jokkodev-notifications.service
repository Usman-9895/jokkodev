[Unit]
Description=JokkoDev transactional email queue (explicit activation)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=jokkodev
Group=jokkodev
WorkingDirectory=/opt/jokkodev/notifications/backend
Environment=NODE_ENV=production
EnvironmentFile=/etc/jokkodev/notifications.env
ExecStart=/usr/local/bin/node dist/src/cli/notifications.js process --confirm-database jokkodev --confirm-host 127.0.0.1:5432 --batch 20 --execute
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
