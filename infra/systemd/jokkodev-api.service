[Unit]
Description=JokkoDev API (NestJS)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jokkodev
Group=jokkodev
WorkingDirectory=/opt/jokkodev/current/backend
# Variables de production (mode 600, propriétaire root). Aucun fichier .env dans le dossier de l'application.
EnvironmentFile=/etc/jokkodev/api.env
ExecStart=/usr/bin/node dist/src/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Stockage des seuls avatars normalisés, indépendant de /opt/jokkodev/current.
# Faire correspondre AVATAR_STORAGE_DIR dans api.env ; à valider sur l'environnement cible.
StateDirectory=jokkodev/avatars
StateDirectoryMode=0700
ReadWritePaths=/var/lib/jokkodev/avatars
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
