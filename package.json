{
  "name": "jokkodev",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jokkodev/frontend --filter @jokkodev/backend dev",
    "dev:frontend": "pnpm --filter @jokkodev/frontend dev",
    "dev:backend": "pnpm --filter @jokkodev/backend dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @jokkodev/backend test && node --test tests/*.test.mjs",
    "test:integration": "pnpm --filter @jokkodev/backend test:integration",
    "db:generate": "pnpm --filter @jokkodev/backend db:generate",
    "db:validate": "pnpm --filter @jokkodev/backend db:validate",
    "db:migrate:dev": "pnpm --filter @jokkodev/backend db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @jokkodev/backend db:migrate:deploy",
    "db:seed": "pnpm --filter @jokkodev/backend db:seed",
    "db:seed:demo": "pnpm --filter @jokkodev/backend db:seed:demo",
    "admin:grant": "pnpm --filter @jokkodev/backend admin:grant",
    "admin:revoke": "pnpm --filter @jokkodev/backend admin:revoke",
    "api:export": "pnpm --filter @jokkodev/backend api:export",
    "api:generate": "pnpm api:export && pnpm --filter @jokkodev/api-client generate",
    "licenses:inventory": "node scripts/licenses.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "reputation:rebuild": "pnpm --filter @jokkodev/backend reputation:rebuild",
    "test:security-ip": "pnpm --filter @jokkodev/backend build && node scripts/security/ip-regression.mjs",
    "retention": "pnpm --filter @jokkodev/backend retention"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "@types/node": "24.19.2",
    "@next/eslint-plugin-next": "16.4.2"
  }
}
