    "/api/v1/technologies": {
      "get": {
        "operationId": "TechnologiesController_list",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Recherche dans le nom, sans tenir compte de la casse.",
            "schema": {
              "maxLength": 50,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 200,
              "default": 200,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalogue commun trié par nom.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TechnologyListDto"
                }
              }
            }
          }
        },
        "tags": [
