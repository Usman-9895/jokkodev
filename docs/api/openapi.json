  "info": {
    "title": "JokkoDev API",
    "description": "API REST de JokkoDev. Session par cookie HttpOnly (`__Host-jokkodev_session` en production) ; toute requête POST, PUT, PATCH ou DELETE exige l’en-tête X-CSRF-Token obtenu via GET /api/v1/auth/csrf et une origine autorisée.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-jokkodev_session"
      }
    },
    "schemas": {
      "CsrfTokenDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "À renvoyer dans l’en-tête X-CSRF-Token de toute requête POST, PUT, PATCH ou DELETE."
          }
        },
        "required": [
          "csrfToken"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "awa@example.com",
            "maxLength": 254
          },
          "username": {
            "type": "string",
            "example": "awa_dev",
            "pattern": "^[A-Za-z0-9_]{3,30}$",
            "description": "3 à 30 caractères : lettres ASCII, chiffres et tiret bas. Unique sans tenir compte de la casse."
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Espaces autorisés, aucune troncature ni règle de composition."
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "example": "awa_dev"
          },
          "email": {
            "type": "string",
            "example": "awa@example.com",
            "description": "Visible uniquement par le titulaire de la session."
          },
          "role": {
            "type": "string",
            "enum": [
              "MEMBER",
              "ADMIN"
            ]
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "role",
          "emailVerified"
        ]
      },
      "AuthResultDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/CurrentUserDto"
          },
          "csrfToken": {
            "type": "string",
            "description": "Nouveau jeton CSRF lié à la session créée."
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Certaines données sont invalides."
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "fieldErrors",
          "requestId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "awa@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "awa@example.com",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton reçu par email (paramètre token du lien).",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton reçu par email (paramètre token du lien).",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "token"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "TechnologyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "TypeScript"
          },
          "slug": {
            "type": "string",
            "example": "typescript"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "TechnologyListDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TechnologyDto"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "ProfileStatsDto": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "number",
            "description": "Questions visibles."
          },
          "answers": {
            "type": "number",
            "description": "Réponses visibles dont la question est visible."
          },
          "projects": {
            "type": "number",
            "description": "Projets visibles créés ou rejoints."
          }
        },
        "required": [
          "questions",
          "answers",
          "projects"
        ]
      },
      "OwnProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "example": "awa_dev"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "countryCode": {
            "type": "string",
            "nullable": true,
            "example": "SN",
            "description": "ISO 3166-1 alpha-2."
          },
          "links": {
            "example": [
              "https://github.com/awa-dev"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TechnologyDto"
            }
          },
          "memberSince": {
            "type": "string",
            "format": "date-time"
          },
          "stats": {
            "$ref": "#/components/schemas/ProfileStatsDto"
          },
          "email": {
            "type": "string",
            "example": "awa@example.com",
            "description": "Privé : visible uniquement par le titulaire."
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "username",
          "links",
          "skills",
          "memberSince",
          "stats",
          "email",
          "emailVerified"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{3,30}$"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "countryCode": {
            "type": "string",
            "nullable": true,
            "example": "SN"
          },
          "links": {
            "maxItems": 3,
            "description": "URLs HTTPS absolues de 2048 caractères au plus.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skillIds": {
            "maxItems": 15,
            "description": "Identifiants de technologies du catalogue.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PublicProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "example": "awa_dev"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "countryCode": {
            "type": "string",
            "nullable": true,
            "example": "SN",
            "description": "ISO 3166-1 alpha-2."
          },
          "links": {
            "example": [
              "https://github.com/awa-dev"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TechnologyDto"
            }
          },
          "memberSince": {
            "type": "string",
            "format": "date-time"
          },
          "stats": {
            "$ref": "#/components/schemas/ProfileStatsDto"
          }
        },
        "required": [
          "id",
          "username",
          "links",
          "skills",
          "memberSince",
          "stats"
        ]
      }
    }
  }
}
