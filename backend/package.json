{
  "name": "@jokkodev/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"node --watch dist/src/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "test:integration": "pnpm build && node --test dist/test/*.integration.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/src/database/seed.js",
    "db:seed:demo": "pnpm build && node dist/src/database/demo.js",
    "admin:grant": "pnpm build && node dist/src/cli/admin.js grant",
    "admin:revoke": "pnpm build && node dist/src/cli/admin.js revoke",
    "api:export": "pnpm build && node dist/src/export-openapi.js",
    "photos:cleanup": "pnpm build && node dist/src/cli/photos-cleanup.js",
    "reputation:rebuild": "pnpm build && node dist/src/cli/reputation.js",
    "retention": "node dist/src/cli/retention.js",
    "publications:prune": "pnpm build && node dist/src/cli/publications-prune.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csrf-csrf": "4.0.3",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jpeg-js": "0.4.4",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "wasm-webp": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "concurrently": "10.0.6",
    "prisma": "7.10.1"
  }
}
