# Copier vers backend/.env. Valeurs exclusivement locales à adapter.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://jokkodev:local_only_change_me@127.0.0.1:5432/jokkodev?schema=public
# Vide : pas de CORS, navigateur via le proxy Next.js. Origines séparées par des virgules.
CORS_ORIGINS=
# Base dédiée aux tests d’intégration (pnpm test:integration). Jamais la base de développement ni de production.
TEST_DATABASE_URL=postgresql://jokkodev:local_only_change_me@127.0.0.1:5432/jokkodev_test

# Origine publique du site : contrôle Origin des mutations et liens des emails. HTTPS obligatoire en production.
APP_ORIGIN=http://localhost:3000
# true en production (cookies __Host- et Secure). false uniquement en HTTP local.
SESSION_COOKIE_SECURE=false
# Au moins 32 caractères aléatoires, distincts par environnement. Obligatoire en production ; en local, une valeur
# aléatoire est générée à chaque démarrage si absente. Exemple : openssl rand -hex 32
CSRF_SECRET=
# Avec pnpm dev (relais Node) ou nginx local : IP exacte du relais ; ports internes non publics.
# En accès DIRECT à Nest sans relais : vide/false. Jamais true, nombre de sauts ou CIDR.
TRUST_PROXY=127.0.0.1

# file : messages écrits en JSON dans MAIL_FILE_DIR (développement). smtp : envoi réel, obligatoire en production.
MAIL_TRANSPORT=file
MAIL_FILE_DIR=.cache/mail
MAIL_FROM=JokkoDev <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optionnel : répertoire ABSOLU durable dédié aux JPEG normalisés. Sans valeur, import indisponible.
# Production : hors dépôt/livraison, par exemple /var/lib/jokkodev/avatars (voir guide lot 18).
AVATAR_STORAGE_DIR=
# Notifications transactionnelles : collecte et worker désactivés par défaut.
# La CLI exige NOTIFICATION_DATABASE_URL et confirmation explicite de destination.
NOTIFICATION_EVENTS_ENABLED=0
NOTIFICATION_WORKER_ENABLED=0
# Optional Google OIDC. Server only. Disabled by default; exact APP_ORIGIN callback.
GOOGLE_AUTH_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# GitHub OAuth — disabled until a dedicated Web OAuth app is configured
GITHUB_AUTH_ENABLED=0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback
# Temporary operator diagnostics: fixed stages/reasons/status only; never raw errors or account data.
GITHUB_AUTH_DIAGNOSTICS_ENABLED=0
